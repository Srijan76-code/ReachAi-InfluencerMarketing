# ==============================================================================
# ReachAI Backend Environment Variables (.env)
# ==============================================================================

# 1. DATABASE (Required)
# Must use postgresql+asyncpg driver for SQLAlchemy async support.
# Example for Neon/Supabase: postgresql+asyncpg://user:pass@ep-xyz.region.aws.neon.tech/neondb
# Example for local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/reachai
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>

# 2. GOOGLE AI STUDIO / GEMINI (Required for LangGraph agent)
# Key from https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# 3. YOUTUBE DATA API v3 (Required for live YouTube channel discovery)
# Key from Google Cloud Console (YouTube Data API v3 enabled)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# 4. CLERK AUTHENTICATION (Optional - defaults to tidy-redfish-49 instance)
CLERK_JWKS_URL=https://tidy-redfish-49.clerk.accounts.dev/.well-known/jwks.json

# 5. INNGEST (Optional for local dev with CLI, required for Inngest Cloud)
# When running `npx inngest-cli@latest dev` locally, keys are not needed.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# 6. APIFY (Optional - for social profiles fallback scraping)
APIFY_API_TOKEN=
