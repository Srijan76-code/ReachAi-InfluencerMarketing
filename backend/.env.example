# ==============================================================================
# ReachAI Backend Environment Variables (.env)
# ==============================================================================

# 1. DATABASE (Required)
# Must use postgresql+asyncpg driver for SQLAlchemy async support.
# Example for Neon/Supabase: postgresql+asyncpg://user:pass@ep-xyz.region.aws.neon.tech/neondb
# Example for local PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/reachai
DATABASE_URL=postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>

# 2. GOOGLE AI STUDIO / GEMINI (Required for LangGraph agent)
# Key from https://aistudio.google.com/
GOOGLE_API_KEY=your_gemini_api_key_here

# 3. YOUTUBE DATA API v3 (Required for live YouTube channel discovery)
# Key from Google Cloud Console (YouTube Data API v3 enabled)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here

# 4. CLERK AUTHENTICATION (Optional - defaults to tidy-redfish-49 instance)
CLERK_JWKS_URL=

# Comma-separated browser origins allowed to call the API.
FRONTEND_ORIGINS=

# 5. INNGEST (Optional for local dev with CLI, required for Inngest Cloud)
# When running `npx inngest-cli@latest dev` locally, keys are not needed.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# 6. APIFY (Optional - for social profiles fallback scraping)
# APIFY_API_TOKEN=

# 7. LLM LAYER (app/llm)
# direct = call providers in fallback order; gateway = LangSmith LLM Gateway holds the chains
LLM_BACKEND=direct
# LANGSMITH_GATEWAY_URL=          # OpenAI-compatible base URL of your gateway (gateway mode)
# LANGSMITH_API_KEY=              # also used for tracing
# GROQ_API_KEY=
# CEREBRAS_API_KEY=
# OPENAI_API_KEY=

# 8. JEV / TYPESAFE (app/judge)
# TYPESAFE_API_KEY=              # a TypeSafe key, or an OpenRouter key (sk-or-...): OpenRouter is detected automatically
# JEV_PROVIDER=auto              # auto | typesafe | openrouter
# JEV_MODEL=                     # optional: override the pinned model version
JEV_MAX_CONCURRENCY=8

# 9. PLATFORM DATA (later phases)
# X_PROVIDER=twitterapi           # twitterapi | official
# X_PROVIDER_API_KEY=
# APIFY_TOKEN=

# Discovery engine: legacy (old pipeline, default) | graph (new engine). Temporary until the old one is removed.
# DISCOVERY_ENGINE=legacy
